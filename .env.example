# 复制为项目根目录的 .env 后，仅在自己电脑填写真实密钥。
# 也可以运行 python scripts/configure_ai.py 交互配置，密钥不会显示在终端。
DEEPSEEK_API_KEY=
CAREERLENS_ANSWER_MODE=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=35
LLM_MAX_OUTPUT_TOKENS=1200
RAG_TOP_K=5

# 线上账号数据库：在 Render 服务环境变量中填写同区域 Postgres 的 Internal Database URL。
# 本地留空时自动使用 database/careerlens_auth.sqlite3；真实连接串不要提交仓库。
DATABASE_URL=
# 本地可选：自定义账号库路径。
# CAREERLENS_AUTH_DB_PATH=database/careerlens_auth.sqlite3
# 分离前端开发使用非默认端口时，可填准确来源，以英文逗号分隔。
# AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5174
